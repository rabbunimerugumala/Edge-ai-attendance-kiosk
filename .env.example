# Touchless Smart Attendance Kiosk - Environment Configuration Template
# Copy this file to .env and insert your deployed Google Apps Script URL:
#   cp .env.example .env

# Google Sheets Apps Script Webhook URL (Replace with your own Web App URL)
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID/exec"

# Flask Secret Key
FLASK_SECRET_KEY="touchless-edge-kiosk-secret-key"
